# ==============================================================================
# RepoMind — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` and provide your API keys.
# NEVER commit your `.env` file to version control.
# ==============================================================================

# Server Configuration
DEBUG=false
PORT=8000
REPOMIND_WORKSPACE_DIR=~/.repomind_workspaces

# ------------------------------------------------------------------------------
# Grounded LLM Intelligence Layer Settings
# ------------------------------------------------------------------------------
# Active provider: gemini | openai | anthropic
# Default is 'gemini'
LLM_PROVIDER=gemini

# Model override (defaults: gemini-2.0-flash, gpt-4o-mini, claude-3-5-sonnet-20241022)
LLM_MODEL=gemini-2.0-flash

# Generation Parameters
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=15.0
LLM_CACHE_TTL_SECONDS=300

# ------------------------------------------------------------------------------
# External LLM API Keys (Keep Strictly Secret)
# ------------------------------------------------------------------------------
# Google Gemini (Recommended — fastest with generous rate limits)
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=

# OpenAI (Alternative)
# Get a key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic Claude (Alternative)
# Get a key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# NOTE: If no external LLM key is configured, RepoMind will automatically and
# gracefully operate in 100% Deterministic Intelligence Mode using native AST,
# call graph, and static risk analysis engines without crashing.
